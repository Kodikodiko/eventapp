{
  "entities": {
    "Event": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Event",
      "type": "object",
      "description": "Represents an event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Event entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the event."
        },
        "startDate": {
          "type": "string",
          "description": "Start date and time of the event.",
          "format": "date-time"
        },
        "endDate": {
          "type": "string",
          "description": "End date and time of the event.",
          "format": "date-time"
        },
        "venueId": {
          "type": "string",
          "description": "Reference to Venue. (Relationship: Event 1:1 Venue)"
        }
      },
      "required": [
        "id",
        "name",
        "startDate",
        "endDate",
        "venueId"
      ]
    },
    "Attendee": {
      "title": "Attendee",
      "description": "Represents an attendee of an event.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "The full name of the attendee."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the attendee."
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "attendee",
              "speaker",
              "orga",
              "sponsor"
            ]
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Confirmed",
            "Waitlisted",
            "Cancelled"
          ]
        },
        "registrationDate": {
          "type": "string",
          "format": "date-time"
        },
        "eventId": {
          "type": "string"
        }
      },
      "required": [
        "fullName",
        "email",
        "roles",
        "status",
        "registrationDate",
        "eventId"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "collections": {
      "/events/{eventId}/attendees": {
        "schema": {
          "$ref": "#/entities/Attendee"
        },
        "description": "Stores attendee information for a specific event."
      }
    }
  }
}
