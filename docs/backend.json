
{
  "entities": {
    "Event": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Event",
      "type": "object",
      "description": "Represents an event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Event entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the event."
        },
        "startDate": {
          "type": "string",
          "description": "Start date and time of the event.",
          "format": "date-time"
        },
        "endDate": {
          "type": "string",
          "description": "End date and time of the event.",
          "format": "date-time"
        },
        "venueId": {
          "type": "string",
          "description": "Reference to Venue. (Relationship: Event 1:1 Venue)"
        }
      },
      "required": [
        "id",
        "name",
        "startDate",
        "endDate",
        "venueId"
      ]
    },
    "Attendee": {
      "title": "Attendee",
      "description": "Represents an attendee of an event.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "The full name of the attendee."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the attendee."
        },
        "company": {
          "type": "string",
          "description": "The company the attendee works for."
        },
        "pmiNumber": {
          "type": "string",
          "description": "The PMI member number of the attendee."
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "attendee",
              "speaker",
              "orga",
              "sponsor"
            ]
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Confirmed",
            "Waitlisted",
            "Cancelled"
          ]
        },
        "registrationDate": {
          "type": "string",
          "format": "date-time"
        },
        "eventId": {
          "type": "string"
        },
        "billingAddress": {
            "type": "string",
            "description": "The billing address of the attendee."
        }
      },
      "required": [
        "fullName",
        "email",
        "roles",
        "status",
        "registrationDate",
        "eventId"
      ]
    },
    "Speaker": {
      "title": "Speaker",
      "description": "Represents a speaker at an event.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The full name of the speaker."
        },
        "company": {
          "type": "string",
          "description": "The company the speaker works for."
        },
        "proposalStatus": {
          "type": "string",
          "enum": [
            "Pending",
            "Confirmed",
            "Rejected"
          ]
        },
        "slidesStatus": {
          "type": "string",
          "enum": [
            "Missing",
            "Uploaded",
            "Review"
          ]
        },
        "eventId": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "company",
        "proposalStatus",
        "slidesStatus",
        "eventId"
      ]
    },
    "SponsorPackage": {
      "title": "SponsorPackage",
      "description": "Defines a sponsorship package for an event.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the package (e.g., Platinum, Gold)."
        },
        "price": {
          "type": "number",
          "description": "The cost of the sponsorship package."
        },
        "benefits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A list of benefits included in the package."
        },
        "eventId": {
          "type": "string"
        }
      },
      "required": ["name", "price", "benefits", "eventId"]
    },
    "Sponsor": {
      "title": "Sponsor",
      "description": "Represents a sponsor for an event.",
      "type": "object",
      "properties": {
        "companyName": {
          "type": "string"
        },
        "packageId": {
          "type": "string",
          "description": "Reference to the SponsorPackage."
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "email": {"type": "string", "format": "email"},
              "phone": {"type": "string"}
            },
            "required": ["name", "email"]
          }
        },
        "billingAddress": {
          "type": "string"
        },
        "paymentDetails": {
          "type": "object",
          "properties": {
            "amount": {"type": "number"},
            "billedAmount": {"type": "number"},
            "dueDate": {"type": "string", "format": "date-time"},
            "status": {
              "type": "string",
              "enum": ["open", "billed", "paid", "overdue"]
            },
            "discount": {"type": "number"}
          },
          "required": ["amount", "status"]
        },
        "eventId": {
          "type": "string"
        }
      },
      "required": ["companyName", "packageId", "contacts", "billingAddress", "paymentDetails", "eventId"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "collections": {
      "/events/{eventId}/attendees": {
        "schema": {
          "$ref": "#/entities/Attendee"
        },
        "description": "Stores attendee information for a specific event."
      },
      "/events/{eventId}/speakers": {
        "schema": {
          "$ref": "#/entities/Speaker"
        },
        "description": "Stores speaker information for a specific event."
      },
      "/events/{eventId}/sponsorPackages": {
        "schema": {
          "$ref": "#/entities/SponsorPackage"
        },
        "description": "Stores sponsorship packages for a specific event."
      },
      "/events/{eventId}/sponsors": {
        "schema": {
          "$ref": "#/entities/Sponsor"
        },
        "description": "Stores sponsors for a specific event."
      }
    }
  }
}
