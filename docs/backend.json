{
  "entities": {
    "Attendee": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Attendee",
      "type": "object",
      "description": "Represents an attendee of an event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Attendee entity."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the attendee."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the attendee."
        },
        "email": {
          "type": "string",
          "description": "Email address of the attendee.",
          "format": "email"
        },
        "registrationDate": {
          "type": "string",
          "description": "Date the attendee registered.",
          "format": "date-time"
        },
        "eventId": {
          "type": "string",
          "description": "Reference to Event. (Relationship: Event 1:N Attendee)"
        },
        "invoiceId": {
          "type": "string",
          "description": "Reference to Invoice. (Relationship: Invoice 1:N Attendee)"
        },
        "sessions": {
          "type": "array",
          "description": "References to Sessions. (Relationship: Session N:N Attendee)",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "registrationDate",
        "eventId"
      ]
    },
    "Speaker": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Speaker",
      "type": "object",
      "description": "Represents a speaker at an event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Speaker entity."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the speaker."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the speaker."
        },
        "email": {
          "type": "string",
          "description": "Email address of the speaker.",
          "format": "email"
        },
        "bio": {
          "type": "string",
          "description": "Biography of the speaker."
        },
        "eventId": {
          "type": "string",
          "description": "Reference to Event. (Relationship: Event 1:N Speaker)"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "bio",
        "eventId"
      ]
    },
    "Sponsor": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Sponsor",
      "type": "object",
      "description": "Represents a sponsor of an event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Sponsor entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the sponsoring company/organization."
        },
        "contactName": {
          "type": "string",
          "description": "Contact person for the sponsor."
        },
        "contactEmail": {
          "type": "string",
          "description": "Contact email for the sponsor.",
          "format": "email"
        },
        "sponsorshipLevel": {
          "type": "string",
          "description": "Level of sponsorship (e.g., Gold, Silver, Bronze)."
        },
        "eventId": {
          "type": "string",
          "description": "Reference to Event. (Relationship: Event 1:N Sponsor)"
        }
      },
      "required": [
        "id",
        "name",
        "contactName",
        "contactEmail",
        "sponsorshipLevel",
        "eventId"
      ]
    },
    "Invoice": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Invoice",
      "type": "object",
      "description": "Represents an invoice for an event registration.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Invoice entity."
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Unique invoice number."
        },
        "issueDate": {
          "type": "string",
          "description": "Date the invoice was issued.",
          "format": "date-time"
        },
        "amount": {
          "type": "number",
          "description": "Total amount of the invoice."
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment status of the invoice (e.g., Paid, Unpaid, Pending)."
        },
        "attendeeId": {
          "type": "string",
          "description": "Reference to Attendee. (Relationship: Attendee 1:1 Invoice)"
        }
      },
      "required": [
        "id",
        "invoiceNumber",
        "issueDate",
        "amount",
        "paymentStatus",
        "attendeeId"
      ]
    },
    "Event": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Event",
      "type": "object",
      "description": "Represents an event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Event entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the event."
        },
        "startDate": {
          "type": "string",
          "description": "Start date and time of the event.",
          "format": "date-time"
        },
        "endDate": {
          "type": "string",
          "description": "End date and time of the event.",
          "format": "date-time"
        },
        "venueId": {
          "type": "string",
          "description": "Reference to Venue. (Relationship: Event 1:1 Venue)"
        }
      },
      "required": [
        "id",
        "name",
        "startDate",
        "endDate",
        "venueId"
      ]
    },
    "Venue": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Venue",
      "type": "object",
      "description": "Represents a venue for an event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Venue entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the venue."
        },
        "address": {
          "type": "string",
          "description": "Address of the venue."
        },
        "capacity": {
          "type": "number",
          "description": "Maximum capacity of the venue."
        }
      },
      "required": [
        "id",
        "name",
        "address",
        "capacity"
      ]
    },
    "Session": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Session",
      "type": "object",
      "description": "Represents a session within an event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Session entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the session."
        },
        "startTime": {
          "type": "string",
          "description": "Start time of the session.",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "description": "End time of the session.",
          "format": "date-time"
        },
        "speakerId": {
          "type": "string",
          "description": "Reference to Speaker. (Relationship: Speaker 1:N Session)"
        },
        "attendeeIds": {
          "type": "array",
          "description": "References to Attendees. (Relationship: Session N:N Attendee)",
          "items": {
            "type": "string"
          }
        },
        "eventId": {
          "type": "string",
          "description": "Reference to Event. (Relationship: Event 1:N Session)"
        }
      },
      "required": [
        "id",
        "name",
        "startTime",
        "endTime",
        "speakerId",
        "eventId"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/events/{eventId}",
        "definition": {
          "entityName": "Event",
          "schema": {
            "$ref": "#/backend/entities/Event"
          },
          "description": "Stores event details. Top-level collection for all event-related data.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            }
          ]
        }
      },
      {
        "path": "/events/{eventId}/attendees/{attendeeId}",
        "definition": {
          "entityName": "Attendee",
          "schema": {
            "$ref": "#/backend/entities/Attendee"
          },
          "description": "Stores attendee information for a specific event. Includes denormalized 'eventId' for authorization independence.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            },
            {
              "name": "attendeeId",
              "description": "Unique identifier for the attendee."
            }
          ]
        }
      },
      {
        "path": "/events/{eventId}/speakers/{speakerId}",
        "definition": {
          "entityName": "Speaker",
          "schema": {
            "$ref": "#/backend/entities/Speaker"
          },
          "description": "Stores speaker information for a specific event. Includes denormalized 'eventId' for authorization independence.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            },
            {
              "name": "speakerId",
              "description": "Unique identifier for the speaker."
            }
          ]
        }
      },
      {
        "path": "/events/{eventId}/sponsors/{sponsorId}",
        "definition": {
          "entityName": "Sponsor",
          "schema": {
            "$ref": "#/backend/entities/Sponsor"
          },
          "description": "Stores sponsor information for a specific event. Includes denormalized 'eventId' for authorization independence.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            },
            {
              "name": "sponsorId",
              "description": "Unique identifier for the sponsor."
            }
          ]
        }
      },
      {
        "path": "/events/{eventId}/invoices/{invoiceId}",
        "definition": {
          "entityName": "Invoice",
          "schema": {
            "$ref": "#/backend/entities/Invoice"
          },
          "description": "Stores invoice information for a specific event. Includes denormalized 'eventId' for authorization independence.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            },
            {
              "name": "invoiceId",
              "description": "Unique identifier for the invoice."
            }
          ]
        }
      },
      {
        "path": "/events/{eventId}/venues/{venueId}",
        "definition": {
          "entityName": "Venue",
          "schema": {
            "$ref": "#/backend/entities/Venue"
          },
          "description": "Stores venue information for a specific event. Includes denormalized 'eventId' for authorization independence.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            },
            {
              "name": "venueId",
              "description": "Unique identifier for the venue."
            }
          ]
        }
      },
      {
        "path": "/events/{eventId}/sessions/{sessionId}",
        "definition": {
          "entityName": "Session",
          "schema": {
            "$ref": "#/backend/entities/Session"
          },
          "description": "Stores session information for a specific event. Includes denormalized 'eventId' for authorization independence.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            },
            {
              "name": "sessionId",
              "description": "Unique identifier for the session."
            }
          ]
        }
      }
    ],
    "reasoning": "The Firestore structure is designed to persist event-related data, including attendees, speakers, sponsors, invoices, events, venues, and sessions. The structure emphasizes authorization independence and supports QAPs (Queries are not filters). Authorization independence is achieved through path-based ownership and denormalization. All data associated with a user or event is nested under the respective parent document (user or event) to enforce clear ownership and avoid `get()` calls in security rules. Segregation is used to ensure that each collection has a homogeneous security posture.\n\nSpecifically, each entity (Attendee, Speaker, Sponsor, etc.) is stored as a subcollection under the `/events/{eventId}` document. This allows all related data to be queried in the context of a specific event. In cases where the Attendee needs to be referenced by invoice, the attendeeId will be stored at the Invoice level, and vice versa.\n\nThe use of subcollections is a strategic decision to prevent large, unwieldy collections at the root level, and to provide clear segregation of event-specific data.\n\nThe structure facilitates secure `list` operations because rules can easily check if the user has access to the event, and consequently, all the data within that event."
  }
}