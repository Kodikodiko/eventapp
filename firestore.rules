
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Allow any signed-in user to read and write to the entire events path and all subcollections.
    // This is a permissive rule for development and should be secured for production.
    match /events/{eventId}/{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
