rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEventOwner(eventId) {
      // In a real app, you would check if the user has ownership of the event.
      // For now, we will allow any signed-in user to act as an owner for any event.
      // This rule should be secured before production.
      return isSignedIn();
    }
    
    match /events/{eventId} {
      allow read, write: if isEventOwner(eventId);

      match /attendees/{attendeeId} {
        allow read, list, create, update, delete: if isEventOwner(eventId);
      }
    }
  }
}
