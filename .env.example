# Beispielkonfiguration für EventFlow.
# Kopieren nach .env.local (lokal) bzw. /etc/eventflow/eventflow.env (Produktion) und Werte eintragen.
# Details: DEPLOYMENT.md, Abschnitt A.3

# Basis-URL der Anwendung (Links in E-Mails, Stripe-Rücksprung)
APP_URL=http://localhost:3000

# SQLite-Datenbank und Sicherungen
DATABASE_PATH=data/eventflow.db
BACKUP_DIR=data/backups

# Better Auth – zufälliger Wert mit mindestens 32 Zeichen, in Produktion ein anderer Wert
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Stripe (lokal Testmodus: sk_test_…, Webhook-Secret von `stripe listen`)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Nur Entwicklung ohne Stripe-Konto: simulierte Kasse (NIE in Produktion setzen)
# PAYMENT_PROVIDER=fake

# E-Mail: "file" schreibt .eml-Dateien nach MAIL_OUTBOX_DIR, "smtp" versendet
MAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=data/mail-outbox
MAIL_FROM="EventFlow <noreply@localhost>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
